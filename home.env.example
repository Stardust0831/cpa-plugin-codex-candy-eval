# Copy to home.env; keep the populated file private (chmod 600 home.env).
# Set the actual Home management address (Home defaults to port 8327).
CPA_HOME_URL=http://127.0.0.1:8327
CPA_HOME_MANAGEMENT_KEY=
# Independent password used to sign into the evaluation panel.
CPA_HOME_EVAL_KEY=
CPA_HOME_EVAL_LISTEN=127.0.0.1:8320
CPA_HOME_EVAL_DATA_DIR=./data
